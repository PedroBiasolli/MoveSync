# Copie para ".env" (que NÃO vai para o Git) ou configure no Azure (App Settings / variáveis da Pipeline).
# No ASP.NET Core, "__" (dois underlines) equivale a ":" na hierarquia do appsettings.

ASPNETCORE_ENVIRONMENT=Production

# Oracle da FIAP (ou Oracle/Azure da equipe)
BancoDados__Provedor=Oracle
BancoDados__VersaoOracle=19
ConnectionStrings__MoveSync=User Id=RMxxxxx;Password=<senha>;Data Source=oracle.fiap.com.br:1521/ORCL

# JWT — gere uma chave aleatória com 32+ caracteres (ex.: openssl rand -base64 48)
Jwt__Chave=<chave-secreta-com-32-ou-mais-caracteres>

# Usuários e sensores de demonstração criados na primeira inicialização
Seed__Habilitado=true
Seed__GestorSenha=<senha-do-gestor>
Seed__CidadaoSenha=<senha-da-cidada>
Seed__SegredoSensores=<segredo-dos-sensores-16+>

# Integração opcional com o núcleo Java (Spring Boot)
Integracoes__NucleoJava__UrlBase=
